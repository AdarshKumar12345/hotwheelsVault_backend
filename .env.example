# ─── Server Environment Variables ────────────────────────────────────────────
# Copy this to .env and fill in your values

# Server port (Render sets this automatically — do not change)
PORT=5001

# Environment
NODE_ENV=production

# MongoDB Atlas connection string
# Get from: cloud.mongodb.com > Clusters > Connect > Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT — Use a long random string (min 32 chars) in production
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Frontend URL — used for CORS whitelist (your Vercel deployment URL)
CLIENT_URL=https://your-app.vercel.app

# Razorpay Payment Gateway
# Get from: razorpay.com > Settings > API Keys
RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET
